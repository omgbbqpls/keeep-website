---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Keeep Blog" description="Artikelen en updates over Keeep en budgetteren.">
  <main class="page narrow">
    <section class="page-hero">
      <p class="eyebrow">Blog</p>
      <h1>Rustige updates, geen contentfabriek.</h1>
      <p class="intro">
        Eerst bouwen we de basis goed: product, methode, download en vertrouwen.
        Daarna komen hier korte artikelen over budgetteren, lokale privacy, productkeuzes en beta-updates.
      </p>
    </section>
    <section class="post-list">
      <article>
        <p class="eyebrow">Gepland</p>
        <h2>Waarom Keeep zonder bankkoppeling begint</h2>
        <p>Een artikel over vertrouwen, lokale data en bewust budgetteren.</p>
      </article>
      <article>
        <p class="eyebrow">Gepland</p>
        <h2>De eerste macOS beta</h2>
        <p>Welke onderdelen stabiel moeten voelen voordat Windows volgt.</p>
      </article>
      <article>
        <p class="eyebrow">Gepland</p>
        <h2>Van saldo naar potjes</h2>
        <p>Waarom een hoog saldo alsnog onrustig kan voelen als het geen plan heeft.</p>
      </article>
    </section>
  </main>
</BaseLayout>
