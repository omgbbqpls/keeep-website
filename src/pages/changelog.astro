---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Changelog - Keeep" description="Productupdates en beta-notities voor Keeep.">
  <main class="page narrow">
    <section class="page-hero page-hero-split">
      <div>
        <p class="eyebrow">Changelog</p>
        <h1>Wat verandert er aan Keeep?</h1>
        <p class="intro">Korte productnotities over wat scherper, stabieler of duidelijker is geworden.</p>
      </div>
      <div class="page-hero-visual">
        <img src="/images/home/adjust-budget.svg" alt="" />
      </div>
    </section>
    <section class="timeline">
      <article>
        <time>2026-05-22</time>
        <h2>Websitepositionering aangescherpt</h2>
        <p>Keeep scherper neergezet als lokale Nederlandse budget-app die mensen helpt hun geld vooraf een taak te geven.</p>
      </article>
      <article>
        <time>2026-05-21</time>
        <h2>Eerste macOS beta-build</h2>
        <p>De eerste complete macOS build is klaar om actief te testen.</p>
      </article>
    </section>
  </main>
</BaseLayout>
