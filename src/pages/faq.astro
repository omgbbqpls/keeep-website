---
import BaseLayout from '../layouts/BaseLayout.astro';

const questions = [
  ['Is Keeep gratis?', 'Tijdens de beta is Keeep beperkt beschikbaar voor testers. De definitieve versie wordt een eenmalige aankoop.'],
  ['Is er een abonnement?', 'Nee. Keeep wordt geen abonnementsdienst.'],
  ['Koppelt Keeep met mijn bank?', 'Nee. Keeep werkt bewust zonder bankkoppeling.'],
  ['Waar staat mijn data?', 'Lokaal op je eigen apparaat. Je kunt zelf back-ups maken en herstellen.'],
  ['Werkt Keeep op Windows en macOS?', 'macOS is beschikbaar als beta. Windows wordt getest en volgt later.'],
  ['Kan ik creditcards gebruiken?', 'Ja. Keeep ondersteunt creditcarduitgaven en betalingen richting creditcard.'],
  ['Wordt ongebruikt budget meegenomen?', 'Ja. Budgetten kunnen maand-op-maand blijven staan, zodat potjes natuurlijk groeien.'],
  ['Is Keeep financieel advies?', 'Nee. Keeep is een hulpmiddel om je eigen geld te plannen.'],
  ['Wat als ik rood sta of te weinig budget heb?', 'Dan maakt Keeep zichtbaar dat geld ergens anders vandaan moet komen. Het doel is bewust kiezen, niet doen alsof het probleem niet bestaat.']
];
---
<BaseLayout title="FAQ - Keeep" description="Antwoorden op veelgestelde vragen over Keeep.">
  <main class="page narrow">
    <section class="page-hero">
      <p class="eyebrow">FAQ</p>
      <h1>Veelgestelde vragen</h1>
      <p class="intro">Kort en eerlijk, want vertrouwen begint bij duidelijkheid.</p>
    </section>
    <section class="faq-list large">
      {questions.map(([question, answer]) => (
        <details>
          <summary>{question}</summary>
          <p>{answer}</p>
        </details>
      ))}
    </section>
  </main>
</BaseLayout>
