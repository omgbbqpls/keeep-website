---
import '../styles/global.css';

const {
  title = 'Keeep',
  description = 'Keeep helpt je geld een duidelijk plan te geven.'
} = Astro.props;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/methode/', label: 'Methode' },
  { href: '/prijs/', label: 'Prijs' },
  { href: '/download/', label: 'Download' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/changelog/', label: 'Changelog' }
];
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Keeep homepage">
        <img src="/images/keeep-icon.png" alt="" />
        <span>Kee<span>ep</span></span>
      </a>
      <nav class="site-nav" aria-label="Hoofdnavigatie">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div>
        <strong>Kee<span>ep</span></strong>
        <p>Geef je geld een plan. Lokaal, nuchter en zonder abonnement.</p>
      </div>
      <nav aria-label="Footer navigatie">
        <a href="/prijs/">Prijs</a>
        <a href="/privacy/">Privacy</a>
        <a href="/voorwaarden/">Voorwaarden</a>
        <a href="/blog/">Blog</a>
      </nav>
    </footer>
  </body>
</html>
