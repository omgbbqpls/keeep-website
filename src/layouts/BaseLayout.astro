---
import '../styles/global.css';

const {
  title = 'Keeep',
  description = 'Keeep helpt je geld een duidelijk plan te geven.'
} = Astro.props;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/download/', label: 'Beta' },
  { href: '/methode/', label: 'Methode' },
  { href: '/prijs/', label: 'Prijs' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/blog/', label: 'Blog' }
];
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner grid-container grid-x align-middle align-justify">
        <a class="brand cell shrink" href="/" aria-label="Keeep homepage">
          <img src="/images/keeep-icon.png" alt="" />
          <span>Kee<span>ep</span></span>
        </a>
        <nav class="site-nav cell shrink" aria-label="Hoofdnavigatie">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="site-footer-inner grid-container grid-x align-middle align-justify">
        <div class="cell medium-5">
          <strong>Kee<span>ep</span></strong>
          <p>Geef je geld een plan. Lokaal, nuchter en zonder abonnement.</p>
        </div>
        <nav class="cell medium-auto" aria-label="Footer navigatie">
          <a href="/prijs/">Prijs</a>
          <a href="/privacy/">Privacy</a>
          <a href="/voorwaarden/">Voorwaarden</a>
          <a href="/changelog/">Changelog</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
